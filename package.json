{
  "name": "gent",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "env -u FORCE_COLOR NO_COLOR=1 concurrently -n oxlint,guards \"env -u FORCE_COLOR NO_COLOR=1 oxlint --ignore-path=.oxlintignore --report-unused-disable-directives-severity=error\" \"bun run guards\"",
    "lint:fix": "env -u FORCE_COLOR NO_COLOR=1 oxlint --ignore-path=.oxlintignore --report-unused-disable-directives-severity=error --fix",
    "guards": "bun packages/tooling/src/check-guardrails.ts",
    "fmt": "env -u FORCE_COLOR NO_COLOR=1 oxfmt --ignore-path=.oxlintignore",
    "fmt:check": "env -u FORCE_COLOR NO_COLOR=1 oxfmt --ignore-path=.oxlintignore --check",
    "build": "turbo run build",
    "install:global": "turbo run install:global --filter=@gent/tui --ui=stream",
    "test": "turbo run test --ui=stream --concurrency=1",
    "test:e2e": "turbo run test:e2e --ui=stream --concurrency=1",
    "gate": "env -u FORCE_COLOR NO_COLOR=1 concurrently -n type,style,build \"bun run typecheck\" \"bun run lint && bun run fmt:check\" \"bun run build\" && bun run test",
    "clean": "rm -rf .turbo */.turbo */*/.turbo",
    "smoke": "d=$(mktemp -d) && trap 'rm -rf \"$d\"' EXIT && GENT_DATA_DIR=\"$d\" bun run --cwd apps/tui dev --debug -H 'Say hi in 3 words'",
    "gamut": "bun testbeds/gamut/gamut.ts",
    "prepare": "lefthook install && effect-tsgo patch --force"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@effect/tsgo": "0.51.1",
    "@gent/core": "workspace:*",
    "@gent/extensions": "workspace:*",
    "@oxlint/plugins": "^1.87.0",
    "@types/bun": "^1.4.2",
    "@types/picomatch": "catalog:",
    "concurrently": "^10.0.6",
    "effect": "catalog:",
    "effect-bun-test": "catalog:",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-plugin-effect": "^0.27.1",
    "oxlint-tsgolint": "^7.0.2004",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@effect/ai-anthropic": "4.0.2",
    "@effect/ai-openai": "4.0.2",
    "@effect/ai-openai-compat": "4.0.2",
    "@effect/ai-typesafe": "4.0.2",
    "@effect/platform-node-shared": "4.0.2",
    "@effect/sql-d1": "4.0.2",
    "effect": "4.0.2"
  },
  "packageManager": "bun@1.4.3",
  "catalog": {
    "effect": "4.0.2",
    "@effect/platform-bun": "4.0.2",
    "@effect/platform-node": "4.0.2",
    "@effect/sql-sqlite-bun": "4.0.2",
    "@effect/sql-sqlite-do": "4.0.2",
    "@effect/opentelemetry": "4.0.2",
    "effect-encore": "^0.33.0",
    "effect-wide-event": "0.6.0",
    "picomatch": "^4.0.7",
    "@types/picomatch": "^4.0.3",
    "effect-bun-test": "0.4.0",
    "solid-js": "^1.9.17",
    "@effect/ai-anthropic": "4.0.2",
    "@effect/ai-openai": "4.0.2",
    "@effect/ai-openai-compat": "4.0.2",
    "@effect/ai-typesafe": "4.0.2",
    "@ff-labs/fff-bun": "0.11.0"
  },
  "patchedDependencies": {
    "@effect/ai-anthropic@4.0.2": "patches/@effect%2Fai-anthropic@4.0.2.patch",
    "@effect/ai-openai@4.0.2": "patches/@effect%2Fai-openai@4.0.2.patch",
    "@effect/ai-openai-compat@4.0.2": "patches/@effect%2Fai-openai-compat@4.0.2.patch",
    "@opentui/core@0.5.17": "patches/@opentui%2Fcore@0.5.17.patch",
    "@effect/platform-node-shared@4.0.2": "patches/@effect%2Fplatform-node-shared@4.0.2.patch",
    "effect@4.0.2": "patches/effect@4.0.2.patch"
  }
}
