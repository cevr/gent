# oxlint and oxfmt both read this via --ignore-path=.oxlintignore (set in the
# package.json scripts and lefthook.yml), so one list serves the linter and the
# formatter; the JSON config's `ignorePatterns` would reach oxlint only. oxlint
# also skips what `.gitignore` ignores (build output, node_modules), so no row
# repeats it; the guards fail on a row that matches no file oxlint would lint.
**/*.d.ts
packages/tooling/fixtures/
# `testbeds/gamut/fixture/` is the deliberately broken ledgerline app the
# agent under test is asked to repair. The gamut driver and its tests are
# linted and formatted like the rest of the repo.
testbeds/gamut/fixture/
