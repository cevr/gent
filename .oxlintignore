# oxlint reads this via --ignore-path=.oxlintignore (set in package.json scripts).
# The JSON config's `ignorePatterns` field appears to be a no-op with current
# oxlint version, so all ignore patterns live here. oxlint also skips what
# `.gitignore` ignores (build output, node_modules), so no row repeats it; the
# guards fail on a row that matches no file oxlint would lint.
**/*.d.ts
packages/tooling/fixtures/
# `testbeds/gamut/fixture/` is the deliberately broken ledgerline app the
# agent under test is asked to repair. The gamut driver and its tests are
# linted and formatted like the rest of the repo.
testbeds/gamut/fixture/
