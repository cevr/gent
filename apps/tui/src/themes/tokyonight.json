{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkStep1": "#1a1b26",
    "darkStep2": "#1e2030",
    "darkStep7": "#737aa2",
    "darkStep9": "#82aaff",
    "darkStep11": "#828bb8",
    "darkStep12": "#c8d3f5",
    "darkRed": "#ff757f",
    "darkOrange": "#ff966c",
    "darkYellow": "#ffc777",
