{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "currentLine": "#717381",
    "foreground": "#f8f8f2",
    "comment": "#8390b7",
    "cyan": "#8be9fd",
    "green": "#50fa7b",
    "orange": "#ffb86c",
    "pink": "#ff79c6",
    "purple": "#bd93f9",
    "red": "#ff5555",
    "yellow": "#f1fa8c",
    "purpleOnLight": "#8164aa",
    "redOnLight": "#c94343",
    "yellowOnLight": "#717642",
    "greenOnLight": "#2a8240",
    "orangeOnLight": "#936a3e",
    "cyanOnLight": "#487983",
    "pinkOnLight": "#ad5286"
  },
  "theme": {
    "primary": {
      "dark": "purple",
      "light": "purpleOnLight"
    },
    "error": {
      "dark": "red",
      "light": "redOnLight"
    },
    "warning": {
      "dark": "yellow",
      "light": "yellowOnLight"
    },
    "success": {
      "dark": "green",
      "light": "greenOnLight"
    },
    "info": {
      "dark": "orange",
      "light": "orangeOnLight"
    },
    "text": {
      "dark": "foreground",
      "light": "#282a36"
    },
    "textMuted": {
      "dark": "comment",
      "light": "#6070a1"
    },
    "background": {
      "dark": "#282a36",
      "light": "#f8f8f2"
    },
    "backgroundPanel": {
      "dark": "#21222c",
      "light": "#e8e8e2"
    },
    "border": {
      "dark": "currentLine",
      "light": "#90908c"
    },
    "diffAdded": {
      "dark": "green",
      "light": "greenOnLight"
    },
    "diffRemoved": {
      "dark": "red",
      "light": "redOnLight"
    },
    "diffAddedBg": {
      "dark": "#1a3a1a",
      "light": "#e0ffe0"
    },
    "diffRemovedBg": {
      "dark": "#3a1a1a",
      "light": "#ffe0e0"
    },
    "diffContextBg": {
      "dark": "#21222c",
      "light": "#e8e8e2"
    },
    "diffAddedLineNumberBg": {
      "dark": "#1a3a1a",
      "light": "#e0ffe0"
    },
    "diffRemovedLineNumberBg": {
      "dark": "#3a1a1a",
      "light": "#ffe0e0"
    },
    "markdownHeading": {
      "dark": "purple",
      "light": "purpleOnLight"
    },
    "markdownLink": {
      "dark": "cyan",
      "light": "cyanOnLight"
    },
    "markdownLinkText": {
      "dark": "pink",
      "light": "pinkOnLight"
    },
    "markdownCode": {
      "dark": "green",
      "light": "greenOnLight"
    },
    "markdownBlockQuote": {
      "dark": "comment",
      "light": "#6070a1"
    },
    "markdownEmph": {
      "dark": "yellow",
      "light": "yellowOnLight"
    },
    "markdownStrong": {
      "dark": "orange",
      "light": "orangeOnLight"
    },
    "markdownListItem": {
      "dark": "purple",
      "light": "purpleOnLight"
    },
    "syntaxComment": {
      "dark": "comment",
      "light": "#6070a1"
    },
    "syntaxKeyword": {
      "dark": "pink",
      "light": "pinkOnLight"
    },
    "syntaxFunction": {
      "dark": "green",
      "light": "greenOnLight"
    },
    "syntaxVariable": {
      "dark": "foreground",
      "light": "#282a36"
    },
    "syntaxString": {
      "dark": "yellow",
      "light": "yellowOnLight"
    },
    "syntaxNumber": {
      "dark": "purple",
      "light": "purpleOnLight"
    },
    "syntaxType": {
      "dark": "cyan",
      "light": "cyanOnLight"
    },
    "syntaxOperator": {
      "dark": "pink",
      "light": "pinkOnLight"
    },
    "syntaxPunctuation": {
      "dark": "foreground",
      "light": "#282a36"
    }
  }
}
