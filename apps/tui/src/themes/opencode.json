{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkStep1": "#0a0a0a",
    "darkStep2": "#141414",
    "darkStep7": "#5d5d5d",
    "darkStep9": "#fab283",
    "darkStep11": "#808080",
    "darkStep12": "#eeeeee",
    "darkAccent": "#9d7cd8",
    "darkRed": "#e06c75",
    "darkOrange": "#f5a742",
    "darkGreen": "#7fd88f",
    "darkCyan": "#56b6c2",
    "darkYellow": "#e5c07b",
    "lightStep1": "#ffffff",
    "lightStep2": "#fafafa",
    "lightStep7": "#949494",
    "lightStep9": "#3876cc",
    "lightStep11": "#767676",
    "lightStep12": "#1a1a1a",
    "lightAccent": "#a26a1e",
    "lightRed": "#d1383d",
    "lightOrange": "#a26a1e",
    "lightGreen": "#35864c",
    "lightCyan": "#2f818f",
    "lightYellow": "#95711a"
