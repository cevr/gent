{
  "name": "@gent/tui",
  "version": "0.0.0",
  "bin": {
    "gent": "bin/gent"
  },
  "type": "module",
  "exports": {
    "./extensions": "./src/extensions.ts"
  },
  "scripts": {
    "dev": "bun src/main.tsx",
    "build": "env -u FORCE_COLOR NO_COLOR=1 bun scripts/build.ts",
    "link": "mkdir -p \"$HOME/.bun/bin\" && ln -sfn \"$PWD/bin/gent\" \"$HOME/.bun/bin/gent\" && echo \"Linked $HOME/.bun/bin/gent -> $PWD/bin/gent\"",
    "typecheck": "tsc --noEmit",
    "test": "env -u FORCE_COLOR NO_COLOR=1 bun test --reporter=dots --preload ../../packages/tooling/src/test-preload.ts --parallel --path-ignore-patterns=\"**/headless-cli-exit.test.ts\" tests",
    "test:e2e": "env -u FORCE_COLOR NO_COLOR=1 bun test --reporter=dots --preload ../../packages/tooling/src/test-preload.ts integration tests/headless-cli-exit.test.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@ff-labs/fff-bun": "catalog:",
    "@gent/core": "workspace:*",
    "@gent/extensions": "workspace:*",
    "@gent/sdk": "workspace:*",
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "beautiful-mermaid": "^1.1.3",
    "diff": "^9.0.0",
    "match-sorter": "^8.3.0",
    "solid-js": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
