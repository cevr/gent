{
  "name": "@gent/extensions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./index.js": "./src/index.ts",
    "./client": "./src/client.ts",
    "./client.js": "./src/client.ts"
  },
  "scripts": {
    "build": "bun build src/cell/main.ts --compile --target=bun-darwin-arm64 --no-compile-autoload-bunfig --no-compile-autoload-dotenv --no-compile-autoload-tsconfig --no-compile-autoload-package-json --outfile dist/gent-cell",
    "typecheck": "tsc --noEmit",
    "test": "env -u FORCE_COLOR NO_COLOR=1 bun test --preload ../../packages/tooling/src/test-log-preload.ts --reporter=dots tests"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@effect/ai-anthropic": "catalog:",
    "@effect/ai-openai": "catalog:",
    "@effect/ai-openai-compat": "catalog:",
    "@ff-labs/fff-bun": "catalog:",
    "@gent/core": "workspace:*",
    "@gent/core-internal": "workspace:*",
    "@types/turndown": "^5.0.6",
    "effect-encore": "catalog:",
    "linkedom": "^0.18.13",
    "picomatch": "catalog:",
    "turndown": "^7.2.4"
  },
  "peerDependencies": {
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:"
  }
}
