{
  "name": "@gent/extensions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "build": "bun build src/cell-worker-boundary.ts --compile --no-compile-autoload-bunfig --no-compile-autoload-dotenv --no-compile-autoload-tsconfig --no-compile-autoload-package-json --outfile dist/gent-cell",
    "typecheck": "tsc --noEmit",
    "test": "env -u FORCE_COLOR NO_COLOR=1 bun test --preload ../../packages/tooling/src/test-preload.ts --reporter=dots --parallel tests"
  },
  "dependencies": {
    "@effect/ai-anthropic": "catalog:",
    "@effect/ai-openai": "catalog:",
    "@gent/core": "workspace:*",
    "effect-encore": "catalog:",
    "picomatch": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:"
  }
}
