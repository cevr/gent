{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "perf": "off"
  },
  "plugins": [],
  "jsPlugins": ["../src/gent-rules.ts"],
  "rules": {
    "gent/no-runpromise-outside-boundary": "error",
    "gent/core-entry-boundary": "error",
    "gent/declared-workspace-imports": "error",
    "gent/no-define-extension-throw": "error",
    "gent/no-dynamic-imports": "error",
    "gent/no-promise-control-flow-in-tests": "error",
    "gent/no-bun-outside-adapter": "error",
    "gent/no-hand-rolled-tagged-union": "error",
    "gent/no-sleep": "error",
    "gent/no-die-in-test-helpers": "error",
    "gent/no-with-wrapper-call": "error",
    "gent/no-inert-it": "error"
  }
}
