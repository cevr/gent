{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "plugins": ["typescript", "import", "node"],
  "settings": {
    // Test code beyond `*.test.*`: the helpers in `tests/` and `integration/`
    // trees, and the harness (`@gent/e2e`, core's `test-utils`).
    "effect": {
      "testFiles": [
        "**/tests/**",
        "**/integration/**",
        "packages/e2e/**",
        "packages/core/src/test-utils/**"
      ]
    }
  },
  // The Effect preset loads its own plugin and enables every recommended rule;
  // a rule below overrides it only where gent deliberately differs.
  "extends": ["./node_modules/oxlint-plugin-effect/presets/recommended.json"],
  "jsPlugins": ["./packages/tooling/src/gent-rules.ts"],
  "rules": {
    // Custom — extensions read only the authoring entries; product code never reads test-utils
    "gent/core-entry-boundary": "error",
    // Custom — a workspace imports only the workspace packages its manifest declares
    "gent/declared-workspace-imports": "error",
    // Custom — a child-session writer admits the depth in its own function
    "gent/child-session-writer-admits": "error",
    // Custom — a whole-object JSON encode decides no identity (shipped source)
    "gent/no-identity-encode": "error",
    // Custom — a TUI reactive scope tracks the session identity, not the record (owner rule)
    "gent/no-tracked-session-record": "error",
    // Custom — TUI text is edited, cut and counted by grapheme (apps/tui/src)
    "gent/no-code-unit-text-edit": "error",
    // Custom — a late TUI reply writes through `repliesInView`, not a counter of its own
    "gent/one-reply-writer": "error",

    // Effect opt-in rules: house policy the preset leaves off.
    "effect/noPositionalLogArguments": "error",
    "effect/noRunPromise": "error",
    // A local `withX` fixture helper stays only in a `tests/` tree; the
    // harness and the `integration/` trees are held to the rule.
    "effect/noWithWrapperCall": [
      "error",
      { "allow": ["withWideEvent"], "testFiles": ["**/tests/**"] }
    ],
    "effect/noTimeoutDieInTests": "error",
    // A test's data directory and its user and project config directories are
    // its own, beside the generic home keys the rule knows.
    "effect/noSharedTestHome": ["error", { "keys": ["GENT_DATA_DIR", "userDir", "projectDir"] }],
    // No `import(...)` or `require(...)`: the compiled binary needs every module
    // reachable through a static import. A deliberate load keeps a line-local
    // suppression with its reason.
    "effect/noDynamicImports": ["error", { "allowNamedBoundaries": false }],
    // Only the platform entry files provide a platform layer; everything else
    // yields the service the entry provides.
    "effect/noPlatformLayerOutsideEntry": [
      "error",
      { "layers": ["BunPlatformLive", "BunGentPlatformLive"] }
    ],
    // `Bun.*` and host process and OS facts stay in the platform adapters, the
    // tooling and the test code (overrides below).
    "effect/noGlobals": [
      "error",
      {
        "members": {
          "Bun": {
            "use": "an Effect platform service (GentPlatform, FileSystem, ChildProcessSpawner, KeyValueStore, Config); Bun stays in adapter, tooling and test code"
          },
          "process": {
            "properties": ["execPath", "kill", "pid", "platform"],
            "use": "GentPlatform or an adapter-local Effect service"
          }
        }
      }
    ],
    "effect/noNodeBuiltinImport": [
      "error",
      {
        "modules": {
          "os": {
            "members": ["homedir", "hostname", "release"],
            "use": "GentPlatform (osInfo, homeDirectory)"
          },
          "process": {
            "members": ["execPath", "kill", "pid", "platform"],
            "use": "GentPlatform or an adapter-local Effect service"
          },
          "bun": {
            "use": "an Effect platform service (GentPlatform, FileSystem, ChildProcessSpawner, KeyValueStore, Config); Bun stays in adapter, tooling and test code"
          },
          "crypto": {
            "use": "Effect Crypto for random bytes and ids, GentPlatform.hash for digests"
          }
        }
      }
    ],

    // TypeScript - no any
    "typescript/no-explicit-any": "error",
    // TypeScript - flag unsafe type assertions (as X)
    "typescript/no-unsafe-type-assertion": "error",

    // TypeScript - no non-null assertions
    "typescript/no-non-null-assertion": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",

    // TypeScript - consistent type imports
    "typescript/consistent-type-imports": [
      "error",
      { "prefer": "type-imports", "fixStyle": "separate-type-imports" }
    ],

    // Import rules
    "import/no-duplicates": "error",

    // Unused vars
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-underscore-dangle": "off",

    // Readability
    "no-nested-ternary": "error",
    // Stricter than the Effect preset (21): gent held this limit before adopting it.
    "complexity": ["error", 20],

    // Disabled — false positives with TS enums, type imports, etc.
    "no-shadow": "off",

    // Type-aware rules — disable auto-enabled ones we don't want yet
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/consistent-return": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-unnecessary-boolean-literal-compare": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/no-unnecessary-type-conversion": "off",
    "typescript/no-misused-spread": "off",
    "typescript/no-floating-promises": "off",
    "typescript/no-duplicate-type-constituents": "off",
    "typescript/no-unnecessary-template-expression": "off"
  },
  "overrides": [
    {
      // Terminal columns measure display width. Numeric gutters and ids keep precise local reasons.
      "files": ["apps/tui/src/**"],
      "rules": { "gent/no-code-unit-padding": "error" }
    },
    {
      // Core and shipped-extension source also take their working directory
      // and host modules through Effect services: `RuntimeEnvironment` or the
      // extension context's `cwd`, `GentPlatform`, Effect `Crypto` and `Path`.
      "files": ["packages/core/src/**", "packages/extensions/src/**"],
      "rules": {
        "effect/noGlobals": [
          "error",
          {
            "members": {
              "Bun": {
                "use": "an Effect platform service (GentPlatform, FileSystem, ChildProcessSpawner, KeyValueStore, Config); Bun stays in adapter, tooling and test code"
              },
              "process": {
                "properties": ["cwd", "execPath", "kill", "pid", "platform"],
                "use": "GentPlatform, RuntimeEnvironment, or the extension context's cwd"
              }
            }
          }
        ],
        "effect/noNodeBuiltinImport": [
          "error",
          {
            "modules": {
              "os": { "use": "GentPlatform (osInfo, homeDirectory)" },
              "bun": { "use": "an Effect platform service" },
              "crypto": {
                "use": "Effect Crypto for random bytes and ids, GentPlatform.hash for digests"
              },
              "url": { "use": "Effect Path.fromFileUrl" },
              "process": {
                "members": ["cwd", "execPath", "kill", "pid", "platform"],
                "use": "GentPlatform, RuntimeEnvironment, or the extension context's cwd"
              }
            }
          }
        ]
      }
    },
    {
      // The platform adapters, the tooling and the test code may reach Bun and
      // the host directly. The retired `Bun.Glob` and `Bun.randomUUIDv7` stay
      // out: the built-in `noGlobals` bans hold the global, in every spelling
      // (`globalThis.Bun`, a computed member, an alias), and the `bun` module
      // ban below holds an import. `node:crypto` stays out
      // everywhere: Effect `Crypto` and `GentPlatform.hash` own ids and digests.
      // `Bun.fetch` stays out too: it is a read-only property the test
      // preload's network guard cannot replace, so a request goes through an
      // Effect `HttpClient` over `globalThis.fetch`, which the guard holds.
      "files": [
        "packages/core/src/runtime/gent-platform-bun.ts",
        "**/*-adapter.ts",
        "packages/tooling/**",
        "packages/e2e/**",
        "packages/core/src/test-utils/**",
        "**/tests/**",
        "**/integration/**",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "rules": {
        "effect/noGlobals": [
          "error",
          {
            "members": {
              "Bun": {
                "properties": ["fetch"],
                "use": "an Effect HttpClient (FetchHttpClient.layer): the test preload guards globalThis.fetch, and Bun.fetch cannot be replaced"
              }
            }
          }
        ],
        "effect/noNodeBuiltinImport": [
          "error",
          {
            "modules": {
              "bun": {
                "members": ["Glob", "randomUUIDv7", "fetch"],
                "use": "Effect FileSystem to list files, GentPlatform.randomId for ids, an Effect HttpClient for a request"
              },
              "crypto": {
                "use": "Effect Crypto for random bytes and ids, GentPlatform.hash for digests"
              }
            }
          }
        ]
      }
    },
    {
      // The platform entry files: each provides the platform layer once.
      "files": [
        "packages/core/src/runtime/gent-platform.ts",
        "packages/core/src/runtime/gent-platform-bun.ts",
        "packages/core/src/host.ts",
        "packages/sdk/src/discovery.ts",
        "packages/sdk/src/server.ts",
        "apps/tui/src/main.tsx",
        "apps/tui/scripts/build.ts",
        "apps/tui/scripts/dev-preload-boundary.ts",
        "packages/tooling/src/check-guide-code.ts"
      ],
      "rules": {
        "effect/noPlatformLayerOutsideEntry": "off"
      }
    },
    {
      // A `-boundary` file holds its module's Promise edges: the runtime runs
      // there, in a test's harness (.ts or .tsx) and in product code (.ts).
      "files": ["**/*-boundary.ts", "**/*-boundary.tsx"],
      "rules": {
        "effect/noPromiseChainsInTests": "off",
        "effect/noEffectRunInTests": "off"
      }
    },
    {
      "files": ["**/*-boundary.ts"],
      "rules": {
        "effect/noRunPromise": "off"
      }
    },
    {
      // The lint plugin runs inside oxlint's Node host, not in an Effect
      // runtime, and reads fields of oxlint's untyped AST nodes by name.
      "files": ["packages/tooling/src/gent-rules.ts"],
      "rules": {
        "effect/noNodeBuiltinImport": "off",
        "effect/noNullish": "off",
        "effect/noReflectGet": "off",
        "effect/noRuntimeTypeof": "off",
        "effect/noTernary": "off",
        "effect/noUnknownParameters": "off",
        "effect/noUnknownReturns": "off",
        "effect/noUnsafeDictionaryType": "off"
      }
    },
    {
      "files": ["packages/sdk/src/discovery.ts"],
      "rules": {
        "effect/noNodeBuiltinImport": "off"
      }
    },
    {
      // The gamut driver is a plain Bun script, not an Effect program: it
      // drives herdr, git and SQLite with async shell calls, and its polls
      // wait one step at a time, and it reads the file system through Node.
      // Type assertions stay banned (`effect/noAs`,
      // `typescript/no-unsafe-type-assertion`): the driver decodes the SQLite
      // rows it reads. Its tests keep every rule, with line suppressions where
      // they write raw rows.
      "files": ["testbeds/gamut/gamut.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        // The script reaches the host through Bun's shell, `console` and `Date`;
        // these members are the bans it keeps, and noGlobals is their one owner;
        // the `process` member follows an alias too.
        "effect/noGlobals": [
          "error",
          {
            "builtins": false,
            "members": {
              "process": {
                "properties": ["env"],
                "use": "the driver's arguments, or Effect Config"
              },
              "Bun": {
                "properties": ["Glob", "randomUUIDv7"],
                "use": "Effect FileSystem to list files, GentPlatform.randomId for ids"
              },
              "fetch": {
                "use": "Bun's $ shell, as the models.dev read does with curl"
              },
              "setTimeout": {
                "use": "a deadline from Date.now() polled by the driver's own wait, or Effect.sleep"
              },
              "setInterval": {
                "use": "the driver's own poll loop, or Effect Schedule"
              },
              "Math": {
                "properties": ["random"],
                "use": "GentPlatform.randomId or Effect Random"
              },
              "crypto": {
                "properties": ["randomUUID"],
                "use": "GentPlatform.randomId or Effect Crypto"
              }
            }
          }
        ],
        "effect/noKnownValueWidening": "off",
        "effect/noNewError": "off",
        "effect/noNodeBuiltinImport": "off",
        "effect/noNullish": "off",
        "effect/noTernary": "off",
        "effect/noThrowStatement": "off",
        "effect/noTryCatch": "off",
        "effect/noUnknownParameters": "off",
        "eslint/no-await-in-loop": "off"
      }
    },
    {
      // The efficiency capture preload replaces the global fetch before gent
      // loads, so it is plain Bun, not an Effect program: it reads its
      // environment, the operator's script JSON and each request body, and
      // throws before the run starts when the environment is unsafe.
      "files": ["docs/architecture/fetch-capture.ts"],
      "rules": {
        "effect/noAs": "off",
        "effect/noAsyncFunction": "off",
        // The preload replaces `fetch`, stamps with `Date` and reads its
        // environment; these members are the bans it keeps, and noGlobals is
        // their one owner.
        "effect/noGlobals": [
          "error",
          {
            "builtins": false,
            "members": {
              "Bun": {
                "properties": ["Glob", "randomUUIDv7"],
                "use": "Effect FileSystem to list files, GentPlatform.randomId for ids"
              },
              "console": {
                "use": "the capture log the preload writes under its scratch directory"
              },
              "setTimeout": {
                "use": "a deadline from Date.now() polled by the driver's own wait, or Effect.sleep"
              },
              "setInterval": {
                "use": "the driver's own poll loop, or Effect Schedule"
              },
              "Math": {
                "properties": ["random"],
                "use": "GentPlatform.randomId or Effect Random"
              },
              "crypto": {
                "properties": ["randomUUID"],
                "use": "GentPlatform.randomId or Effect Crypto"
              }
            }
          }
        ],
        "effect/noNewError": "off",
        "effect/noNodeBuiltinImport": "off",
        "effect/noNullish": "off",
        "effect/noRuntimeTypeof": "off",
        "effect/noTernary": "off",
        "effect/noThrowStatement": "off",
        "effect/noUnsafeDictionaryType": "off"
      }
    },
    {
      // The test preload's network guard replaces fetch, the `node:net`
      // socket's `connect`, `WebSocket` and `Bun.connect` before any test
      // module loads, so it is plain Bun at those edges: each guard refuses
      // with its entry point's own failure (a thrown Error, or a rejected
      // promise where the entry point returns one), and calls the entry point
      // it replaced with the caller's `this` and arguments.
      "files": ["packages/tooling/src/test-preload.ts"],
      "rules": {
        "effect/noNewError": "off",
        "effect/noNewPromise": "off",
        "effect/noReflectApply": "off",
        "effect/noThrowStatement": "off",
        "typescript/unbound-method": "off"
      }
    },
    {
      // The cell value reader reads any JavaScript value a cell made, null and
      // undefined included, through descriptors and the intrinsics it saves
      // from the realm's globals when it loads, before any cell runs.
      "files": ["packages/extensions/src/cell-value.ts"],
      "rules": {
        "effect/noNullish": "off",
        "effect/noObjectParameters": "off",
        "effect/noReflectApply": "off",
        "effect/noReflectGet": "off",
        "effect/noUnknownParameters": "off",
        "effect/noUnknownReturns": "off"
      }
    },
    {
      // The cell worker evaluates model code in its realm. Its tool namespace
      // is a Proxy whose `get` trap forwards other keys to the target with the
      // receiver, and an evaluated cell yields a value the cell value reader
      // parses afterwards.
      "files": ["packages/extensions/src/cell-worker-boundary.ts"],
      "rules": {
        "effect/noReflectGet": "off",
        "effect/noUnknownReturns": "off"
      }
    },
    {
      // The scripted model numbers the ids of the stream parts and tool calls
      // it builds, so each id is unique in the process; only uniqueness counts.
      "files": ["packages/core/src/runtime/provider.ts"],
      "rules": {
        "effect/noModuleLevelMutableState": "off"
      }
    },
    {
      // The render harness holds the renderer that the bun:test `afterEach`
      // tears down, and the platform services every render in the test
      // process shares. A mocked client method returns whatever its test gives.
      "files": ["apps/tui/tests/render-harness-boundary.tsx"],
      "rules": {
        "effect/noModuleLevelMutableState": "off",
        "effect/noUnknownReturns": "off"
      }
    },
    {
      // The shared test preload runs in bun's test host before any Effect
      // runtime: it sets the process's data directory synchronously, points
      // the `os` module's home at it for every test file, and removes it
      // after the process's last test.
      "files": ["packages/tooling/src/test-preload.ts"],
      "rules": {
        "effect/noModuleMocks": "off",
        "effect/noNodeBuiltinImport": "off",
        "effect/noTestLifecycleHooks": "off"
      }
    },
    {
      // A test composes the layers its operation needs; that is the test norm.
      "files": ["**/tests/**", "**/integration/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "effect/noInlineProvide": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
