{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.json", "package.json", "patches/*.patch"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["src/**", "tsconfig.json", "package.json"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "inputs": ["src/**", "tests/**", "integration/**", "tsconfig.json", "package.json"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "env": ["GENT_COMPILE_TARGET"],
      "outputs": ["dist/**"]
    },
    "install:global": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "outputs": [],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
